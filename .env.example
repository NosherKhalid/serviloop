# Public client configuration (safe to ship in the app bundle: protected by Row Level Security).
# Copy this file to `.env` and fill in the two values from the Supabase dashboard:
#   URL:             Project Settings -> API -> Project URL
#   Publishable key: Project Settings -> API Keys -> "Publishable key" (starts with sb_publishable_)
# NEVER put a secret key (sb_secret_...), service_role key, database password or AI provider key here:
# every EXPO_PUBLIC_* value is visible to anyone who opens the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
